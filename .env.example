# Copy this file to .env, then fill it in. .env stays private: Git and Docker image builds ignore it.

# Required. Use a long random value, such as the output of:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Devices that log readings must send this key. Generate it the same way.
API_SECRET_KEY=

# Addresses you open the app from. Add your https:// Tailscale address here if you use one.
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Which network address port 8000 listens on. 127.0.0.1 means this computer only, for use with Tailscale Serve.
# Use 0.0.0.0 to allow your whole local network, including guests and smart devices.
BIND_ADDRESS=127.0.0.1
